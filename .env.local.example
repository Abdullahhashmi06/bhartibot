# Copy this file to .env.local and fill in the values for your InternIQ deployment
# from the Supabase project dashboard (Project Settings → API).
#
# Both of these are the PUBLIC url/anon key — safe to expose in the browser.
# NEVER put the service-role key in this file or in any client component.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used by lib/ai/gemini.ts. Never prefix with NEXT_PUBLIC_.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
