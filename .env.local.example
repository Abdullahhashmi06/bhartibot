# Copy this file to .env.local and fill in the values Developer B gives you
# from the Supabase project dashboard (Project Settings → API).
#
# Both of these are the PUBLIC url/anon key — safe to expose in the browser.
# NEVER put the service-role key in this file or in any client component.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
