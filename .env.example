# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Google reCAPTCHA v3 ─────────────────────────────────────────────────────
# Site key is public and safe to ship to the browser (NEXT_PUBLIC_*).
# Get both keys at https://www.google.com/recaptcha/admin (type: reCAPTCHA v3).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional tuning (sane defaults shown):
# Minimum accepted score (0.0 – 1.0). Lower = more permissive, higher = stricter.
RECAPTCHA_SCORE_THRESHOLD=0.5
# Set to "true" to let requests through when Google's API itself is unreachable.
# Default is "false" (fail closed). Prefer "false" in production.
RECAPTCHA_FAIL_OPEN=false
# Optional: pin the verified hostname, e.g. https://app.interniq.com (no trailing slash).
# Leave empty to skip hostname verification.
RECAPTCHA_EXPECTED_HOSTNAME=

# ── Optional: Google GenAI / AI features ────────────────────────────────────
# (existing InternIQ AI keys, if used)
