# ── InternIQ environment variables ─────────────────────────────────────────
# Copy this file to `.env.local` and fill in real values.
# Never commit real secrets. Server-only vars (no NEXT_PUBLIC_ prefix) are
# never sent to the browser.

# ── Supabase ────────────────────────────────────────────────────────────────
# Public URL + anon key — safe to expose in the browser.
# From Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — service-role key. NEVER in client code, NEVER committed.
# Used only by server-side admin clients (e.g. share-link token lookups).
SUPABASE_SERVICE_ROLE_KEY=

# ── Google reCAPTCHA v3 ─────────────────────────────────────────────────────
# Site key is public and safe to ship to the browser (NEXT_PUBLIC_*).
# Get both keys at https://www.google.com/recaptcha/admin (type: reCAPTCHA v3).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional tuning (sane defaults shown):
# Minimum accepted score (0.0 – 1.0). Lower = more permissive, higher = stricter.
RECAPTCHA_SCORE_THRESHOLD=0.5
# Set to "true" to let requests through when Google's API itself is unreachable.
# Default is "false" (fail closed). Prefer "false" in production.
RECAPTCHA_FAIL_OPEN=false
# Optional: pin the verified hostname, e.g. https://app.interniq.com (no trailing slash).
# Leave empty to skip hostname verification.
RECAPTCHA_EXPECTED_HOSTNAME=
# Rate limiting for the reCAPTCHA verification endpoint (per IP, in-memory).
RECAPTCHA_RATE_LIMIT_MAX=20
RECAPTCHA_RATE_LIMIT_WINDOW_MS=60000

# ── AI providers (server-only) ──────────────────────────────────────────────
# Primary provider: gemini | openrouter | groq
AI_PROVIDER=
# Comma-separated fallback chain, e.g. "openrouter,groq,gemini"
AI_FALLBACK_ORDER=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
# Tuning (sane defaults shown):
AI_TIMEOUT_MS=30000
AI_RETRY_COUNT=2
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000

# ── SMTP email (server-only) ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="InternIQ <noreply@yourdomain.com>"
# Enables /api/email/lab + /api/email/test outside development. Never set on
# production unless you intentionally want the developer email lab live.
EMAIL_TEST_SECRET=

# ── PWA / app metadata ──────────────────────────────────────────────────────
# Public base URL, e.g. https://app.interniq.com (used for canonical/OG links).
NEXT_PUBLIC_APP_URL=
# Optional version/build info shown in the Settings page (built at deploy time).
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_BUILD_ID=dev
NEXT_PUBLIC_BUILD_DATE=
# Public VAPID key for the future-ready push-notification architecture
# (lib/push). Unused until push is enabled.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Provided automatically by Vercel ────────────────────────────────────────
# VERCEL_GIT_COMMIT_SHA is read when present for build-id display; no setup
# required on Vercel, ignored locally.
